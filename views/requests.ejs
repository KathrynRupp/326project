<%
  const formatDate = (value) =>
    new Date(value).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      timeZone: "UTC",
    });
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Requests</title>
    <link rel="stylesheet" href="/style.css"/>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <%- include('partials/header') %>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <h2 class="mb-4 text-2xl font-semibold text-slate-900">Requests</h2>
      <form id="request-form" class="card grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block"><span class="sr-only">What do you need</span><input class="form-input" type="text" name="title" placeholder="What do you need" /></label>
        <label class="block"><span class="sr-only">Category</span><select class="form-input" name="category">
          <option value="">Choose a category</option>
          <option value="calculators">Calculator</option>
          <option value="textbooks">Textbooks</option>
          <option value="clothing">Clothing</option>
          <option value="kitchen">Kitchen</option>
          <option value="other">Other</option>
        </select></label>
        <label class="block"><span class="sr-only">Details (optional)</span><input class="form-input" type="text" name="description" placeholder="Details (optional)"/></label>
        <label class="block"><span class="sr-only">Your name</span><input class="form-input" type="text" name="requesterName" placeholder="Your Name"/></label>
        <label class="flex flex-col gap-1 text-sm text-slate-600 sm:flex-row sm:items-center sm:gap-2 lg:col-span-3">
          Needed by (optional)
          <input class="form-input sm:w-auto" type="date" name="neededBy"/>
        </label>
        <button class="btn-primary" type="submit">Post Request</button>
      </form>
      <p id="status" class="sr-only" role="status" aria-live="polite"></p>
      <ul id="requests" class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% requests.forEach((request) => { %>
          <li class="card flex flex-wrap items-center gap-2" data-id="<%= request._id %>" data-title="<%= request.title %>" data-category="<%= request.category %>" data-description="<%= request.description || '' %>" data-requester-name="<%= request.requesterName %>" data-needed-by="<%= request.neededBy ? request.neededBy.toISOString().slice(0, 10) : '' %>">
            <span class="request-display basis-full min-w-0 break-words text-sm sm:flex-1 sm:basis-0"><strong><%= request.title %>:</strong> (<%= request.category %>)<% if (request.description) { %> <%= request.description %><% } %> requested by <%= request.requesterName %><% if (request.neededBy) { %>, needed by <%= formatDate(request.neededBy) %><% } %></span>

            <button class="edit-btn btn-edit" type="button" aria-label="Edit <%= request.title %>">Edit</button>
            <button
              class="delete-btn btn-delete"
              type="button"
              aria-label="Delete <%= request.title %>"
              hx-delete="/requests/<%= request._id %>"
              hx-target="closest li"
              hx-swap="outerHTML"
              hx-confirm="Delete this request?">
              Delete
            </button>

          </li>
        <% }); %>
      </ul>
    </main>
    <script src="/requests.js" defer></script>
  </body>
</html>
